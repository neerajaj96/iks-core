@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix iks: <urn:iks:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

iks:SourceShape a sh:NodeShape ;
    sh:targetClass iks:Source ;
    sh:property [
        sh:path iks:sourceType ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:url ;
        sh:minCount 1 ;
        sh:datatype xsd:anyURI ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:localPath ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:sha256 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-f0-9]{64}$" ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:license ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:retrievedAt ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Violation
    ] .

iks:CitationShape a sh:NodeShape ;
    sh:targetClass iks:Citation ;
    sh:property [
        sh:path iks:source ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:locator ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:sourceSha256 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-f0-9]{64}$" ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:retrievedAt ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Violation
    ] ;
    sh:or (
        [
            sh:path iks:evidenceQuote ;
            sh:minCount 1 ;
            sh:datatype xsd:string ;
            sh:severity sh:Violation
        ]
        [
            sh:path iks:recordHash ;
            sh:minCount 1 ;
            sh:datatype xsd:string ;
            sh:pattern "^[a-f0-9]{64}$" ;
            sh:severity sh:Violation
        ]
    ) .

iks:ClaimShape a sh:NodeShape ;
    sh:targetClass iks:Claim ;
    sh:property [
        sh:path iks:subject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:relation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:object ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:claimText ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:assertionType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "textual_listing"
            "textual_count"
            "textual_definition"
            "textual_attestation"
            "textual_crosscheck"
            "lexical_attestation"
            "dataset_attestation"
            "dataset_crosscheck"
            "editorial_gloss"
            "editorial_taxonomy"
            "editorial_identification"
            "doxographic_coverage"
        ) ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:verificationStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "verified_primary"
            "verified_secondary"
            "flagged_uncertain"
            "editorial"
        ) ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:method ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "exact_string_match"
            "normalized_string_match"
            "cross_witness_match"
            "dataset_record_join"
            "dataset_crosscheck"
            "source_paraphrase"
            "editorial_selection"
        ) ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:citation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:rationale ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .

iks:KnowledgeEntityShape a sh:NodeShape ;
    sh:targetClass iks:KnowledgeEntity ;
    sh:property [
        sh:path <http://www.w3.org/2004/02/skos/core#prefLabel> ;
        sh:minCount 1 ;
        sh:severity sh:Violation
    ] ;
    sh:or (
        [
            sh:path iks:hasClaim ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:severity sh:Violation
        ]
        [
            sh:path iks:scopeNote ;
            sh:minCount 1 ;
            sh:severity sh:Violation
        ]
    ) .

iks:ListComponentShape a sh:NodeShape ;
    sh:targetClass iks:ListComponent ;
    sh:property [
        sh:path iks:componentOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:componentRef ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:componentCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:severity sh:Violation
    ] .

iks:TextShape a sh:NodeShape ;
    sh:targetClass iks:Text ;
    sh:property [
        sh:path iks:titleSa ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:titleEn ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:hasWitness ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation
    ] .

iks:CanonicalListShape a sh:NodeShape ;
    sh:targetClass iks:CanonicalList ;
    sh:property [
        sh:path iks:memberCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:listBasis ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:hasClaim ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation
    ] .

iks:TaxonomyGroupShape a sh:NodeShape ;
    sh:targetClass iks:TaxonomyGroup ;
    sh:property [
        sh:path iks:scopeNote ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:selectionBasis ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:hasMember ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation
    ] .

iks:DhatuShape a sh:NodeShape ;
    sh:targetClass iks:Dhatu ;
    sh:property [
        sh:path iks:rootSlp1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:rootSa ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:rootIast ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:gana ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 10 ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:pada ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "P" "A" "U" ) ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:meaningSa ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:meaningEn ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:dhatupathaCode ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]{2}\\.[0-9]{4}$" ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:crosscheckSource ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation
    ] .

iks:VyakaranaTermShape a sh:NodeShape ;
    sh:targetClass iks:VyakaranaTerm ;
    sh:property [
        sh:path iks:termSa ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:termIast ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:termEn ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:definition ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:definedBy ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation
    ] .

iks:RuleShape a sh:NodeShape ;
    sh:targetClass iks:Rule ;
    sh:property [
        sh:path iks:ruleNumber ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:ruleTextSa ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:ruleTextIast ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path iks:ruleTextSlp1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation
    ] .
