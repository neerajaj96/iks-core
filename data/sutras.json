[{"id": "NS-1.1.1", "textId": "NS", "adhyaNotation": "NS 1.1.1", "sanskrit": "pramāṇaprameyasaṃśayaprayojanadṛṣṭāntasiddhāntāvayavatarkanirṇayavādajalpavitaṇḍāhetvābhāsacchalajātinigrahasthānānāṃ tattvajñānānniḥśreyasādhigamaḥ", "translation": "Supreme good from true knowledge of the 16 categories", "padarthasMentioned": ["Nyaya16"], "pramanasInvoked": [], "logicalForm": "tattva-jnana(N16) -> nihsreyasa"}, {"id": "NS-1.1.3", "textId": "NS", "adhyaNotation": "NS 1.1.3", "sanskrit": "pratyakṣānumānopamānaśabdāḥ pramāṇāni", "translation": "Perception, inference, comparison, word are pramanas", "padarthasMentioned": ["pramana"], "pramanasInvoked": ["Pratyaksa", "Anumana", "Upamana", "Sabda"]}, {"id": "NS-1.1.4", "textId": "NS", "adhyaNotation": "NS 1.1.4", "sanskrit": "indriyārthasannikarṣotpannaṃ jñānam avyapadeśyam avyabhicāri vyavasāyātmakaṃ pratyakṣam", "translation": "Perception: cognition from sense-object contact, inexpressible-free, non-errant, determinate", "padarthasMentioned": ["pramana"], "pramanasInvoked": ["Pratyaksa"]}, {"id": "NS-1.1.32", "textId": "NS", "adhyaNotation": "NS 1.1.32", "sanskrit": "pratijñāhetūdāharaṇopanayanigamanānyavayavāḥ", "translation": "Thesis, reason, example, application, conclusion are the members", "padarthasMentioned": ["avayava"], "pramanasInvoked": ["Anumana"], "logicalForm": "P(a); H(a); ∀x(H→P)+drstanta; H(a)&vyapti; ∴P(a)"}, {"id": "VS-1.1.5", "textId": "VS", "adhyaNotation": "VS 1.1.5", "sanskrit": "pṛthivyāpastejovāyurākāśaṃ kālo digātmā mana iti dravyāṇi", "translation": "Earth water fire air ether time direction self mind are substances (9)", "padarthasMentioned": ["Dravya"], "pramanasInvoked": []}, {"id": "VS-1.1.7", "textId": "VS", "adhyaNotation": "VS 1.1.7", "sanskrit": "utkṣepaṇamavakṣepaṇamākuñcanaṃ prasāraṇaṃ gamanamiti karmāṇi", "translation": "Upward/downward/contraction/expansion/going are the motions (5)", "padarthasMentioned": ["Karma"], "pramanasInvoked": []}, {"id": "SK-4", "textId": "SK", "adhyaNotation": "SK 4", "sanskrit": "dṛṣṭamanumānamāptavacanaṃ ca sarvapramāṇasiddhatvāt", "translation": "Seen, inferred, apt-word: all pramanas established", "padarthasMentioned": ["pramana"], "pramanasInvoked": ["Pratyaksa", "Anumana", "Sabda"]}]
